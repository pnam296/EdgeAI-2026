CONFIG_IDF_TARGET="esp32s3"
# Board N16R8: flash 16MB, app 4MB (partitions.csv). Board flash 4MB -> 4MB + SINGLE_APP_LARGE.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM bat buoc: tensor arena detection ~1.5 MB (conv1 out 240x320x16 int8).
# Board N16R8 / N8R8 = Octal. Board Quad PSRAM -> CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16

# Camera OV7670 (lay tu ov7670_webcam): DMA thang vao PSRAM, task camera o core 1
CONFIG_OV7670_SUPPORT=y
CONFIG_CAMERA_PSRAM_DMA=y
CONFIG_CAMERA_CORE1=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
